<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      READ_PHONE_STATE lets the *settings UI* read the real SIM (if any) so the
      "clone current SIM" feature can pre-fill a profile. The hooks themselves do
      not need any permission: they run inside the target app's own process.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!--
      Needed so the per-app scope picker can enumerate ALL installed apps. On
      Android 11+ getInstalledApplications() is filtered by package visibility and
      returns only a subset (system + auto-visible apps), which is why user apps
      like CPU-Z never appeared. This is the intended permission for an app-list
      picker; appropriate for a sideloaded root/testing tool.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Lets the settings app publish config into Settings.Global — the visibility-
      proof channel that hooks in targetSdk 36+ apps can always read. Not auto-
      granted; grant once on a test device with:
        adb shell pm grant com.simemu.spoof android.permission.WRITE_SECURE_SETTINGS
      If not granted, ConfigStore falls back to `su settings put` (rooted device).
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimEmulator"
        android:forceQueryable="true"><!--
        forceQueryable makes this app (and its ConfigProvider) resolvable from ANY
        app regardless of that app's <queries>, defeating Android 11+ package
        visibility filtering. Honoured for sideloaded apps, which this module always
        is. Without it, hooked targets get "Unknown authority" when reading config. -->

        <!-- ============ LSPosed / Xposed module registration ============ -->
        <!-- Marks this APK as an Xposed module so LSPosed lists and activates it. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <!-- 82 = the classic Xposed API level LSPosed implements. -->
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- Default scope shown in LSPosed. android is included so the phone
             process / system server binder paths can also be reached. -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- ==================== Settings application ==================== -->
        <activity
            android:name=".settings.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets LSPosed's "module settings" shortcut open this screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!--
          Config bridge for the hooks. Exported so hooked apps (different uids) can
          call it over binder — the SELinux-safe alternative to XSharedPreferences.
          No permission: the fake-SIM config is non-sensitive test data.
        -->
        <provider
            android:name=".core.ConfigProvider"
            android:authorities="com.simemu.spoof.config"
            android:exported="true" />

        <activity
            android:name=".settings.ProfileEditActivity"
            android:exported="false" />
        <activity
            android:name=".settings.ScopeActivity"
            android:exported="false" />

    </application>
</manifest>
